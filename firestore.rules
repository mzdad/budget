rules_version = '2';

// Who may read and change what in the budget's online storage (Firestore).
// These rules run on Firebase's side, so they hold whatever a page or app sends.
//
// Each account's months live in budgets/<username>/months/<2026-09>, and only that account may
// touch them. They are filed under the username rather than Firebase's internal account id, so if a
// forgotten password means deleting and re-creating an account, the numbers are still there.
service cloud.firestore {
  match /databases/{database}/documents {

    match /budgets/{username}/months/{month} {
      allow read, delete: if isOwner(username);
      allow create, update: if isOwner(username)
        && isMonthName(month)
        && isValidMonth(request.resource.data);
    }

    // A kid's own page. The parent makes it (budgets/<username>/kidpages/<token>) and gives the kid a
    // link that holds the token. Whoever knows the token can read that one page and ADD entries to it
    // (what the kid used) - nothing else. Nobody can list the pages without being the account owner,
    // so the tokens cannot be found by looking; they are 24 random letters and digits.
    match /budgets/{username}/kidpages/{token} {
      allow get: if true;
      allow list, delete: if isOwner(username);
      allow create, update: if isOwner(username)
        && token.matches('[a-z0-9]{20,40}')
        && isValidKidPage(request.resource.data);

      match /entries/{entry} {
        allow get, list: if true;
        // Added once and never changed. Only while the page exists, so taking the link away stops it.
        allow create: if entry.matches('[a-z0-9]{6,40}')
          && exists(/databases/$(database)/documents/budgets/$(username)/kidpages/$(token))
          && isValidKidEntry(request.resource.data);
        allow update: if false;
        allow delete: if isOwner(username);
      }
    }

    // Everything else is closed: no other path can be read or written by anyone.

    // The username of whoever is signed in: the part of their made-up email before the @.
    function signedInName() {
      return request.auth.token.email.split('@')[0];
    }

    // Signed in with an account made by this page: its made-up email is exactly
    // <username>@budget.example.com (see USERNAME_EMAIL_DOMAIN in account.js).
    function signedIn() {
      return request.auth != null
        && request.auth.token.email == signedInName() + '@budget.example.com';
    }

    function isOwner(username) {
      return signedIn() && signedInName() == username;
    }

    // "2026-09": four digits, a dash, and a month from 01 to 12.
    function isMonthName(month) {
      return month.matches('[0-9]{4}-(0[1-9]|1[0-2])');
    }

    // Only the fields the page writes, and sensible amounts of rows. The row limits are the same
    // numbers as MOST_INCOME_ROWS, MOST_FIXED_ROWS, MOST_CATEGORIES and MOST_SPENDING_PER_MONTH
    // in budget.js. Savings is in øre (1 kr = 100 øre), at most 10 million kr.
    // startBalance ("money I have now", used by Fremtid) is optional: a month without it is fine.
    // pots (your kids' money in your pile) is optional too, and at most 500 entries a month
    // (MOST_POT_ENTRIES_PER_MONTH in budget.js).
    // balances ("money now" on Fremtid: Lønkonto and Opsparing) is optional as well.
    function isValidMonth(data) {
      return data.keys().hasOnly(['income', 'fixed', 'savings', 'categories', 'spending', 'startBalance', 'balances', 'pots', 'updatedAt'])
        && data.keys().hasAll(['income', 'fixed', 'savings', 'categories', 'spending', 'updatedAt'])
        && data.income is list && data.income.size() <= 50
        && data.fixed is list && data.fixed.size() <= 100
        && data.savings is int && data.savings >= 0 && data.savings <= 1000000000
        && data.categories is list && data.categories.size() <= 50
        && data.spending is list && data.spending.size() <= 2000
        && (!('startBalance' in data)
            || (data.startBalance is int && data.startBalance >= 0 && data.startBalance <= 1000000000))
        && (!('balances' in data) || isValidBalances(data.balances))
        && (!('pots' in data) || (data.pots is list && data.pots.size() <= 500))
        && data.updatedAt == request.time;
    }

    // A kid page: the kid's name, and what the parent has written down for the kid (in øre, the
    // kid's own entries are added to it on the kid's page).
    function isValidKidPage(data) {
      return data.keys().hasOnly(['person', 'parentSide', 'updatedAt'])
        && data.keys().hasAll(['person', 'parentSide', 'updatedAt'])
        && data.person is string && data.person.size() >= 1 && data.person.size() <= 60
        && data.parentSide is int && data.parentSide >= -1000000000000 && data.parentSide <= 1000000000000
        && data.updatedAt == request.time;
    }

    // What a kid writes: a day, an amount that is NEGATIVE (money used, never money added), a short
    // note and the moment (milliseconds, see MOST_MOMENT in budget.js).
    function isValidKidEntry(data) {
      return data.keys().hasOnly(['date', 'amount', 'note', 'at'])
        && data.keys().hasAll(['date', 'amount', 'note', 'at'])
        && data.date is string && data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && data.amount is int && data.amount < 0 && data.amount >= -1000000000
        && data.note is string && data.note.size() <= 100
        && data.at is int && data.at > 0 && data.at <= 100000000000000;
    }

    // Only "account" and "savings", each one optional.
    function isValidBalances(balances) {
      return balances is map
        && balances.keys().hasOnly(['account', 'savings'])
        && (!('account' in balances) || isValidBalance(balances.account))
        && (!('savings' in balances) || isValidBalance(balances.savings));
    }

    // One typed number: an amount in øre (it may be negative, an account can be overdrawn, at most
    // 10 million kr either way) and the moment it was typed, in milliseconds (MOST_MOMENT in budget.js).
    function isValidBalance(balance) {
      return balance is map
        && balance.keys().hasOnly(['amount', 'at'])
        && balance.keys().hasAll(['amount', 'at'])
        && balance.amount is int && balance.amount >= -1000000000 && balance.amount <= 1000000000
        && balance.at is int && balance.at > 0 && balance.at <= 100000000000000;
    }
  }
}
